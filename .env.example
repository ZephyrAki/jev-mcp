# Private deployment values. Replace every REPLACE_ME before use.
# The program reads process environment; it does not automatically load this file.
ZEPHYR_DATA_DIR=./data
MCP_PUBLIC_BASE_URL=https://mcp.example.com
MCP_PORT=8765
GITHUB_CLIENT_ID=REPLACE_ME
GITHUB_CLIENT_SECRET=REPLACE_ME
GITHUB_ALLOWED_USER_IDS=REPLACE_ME
FASTMCP_JWT_SIGNING_KEY=REPLACE_ME
OAUTH_STORAGE_FERNET_KEY=REPLACE_ME
TYPESAFE_API_KEY=REPLACE_ME
TYPESAFE_DEFAULT_MODEL=jev-latest
TYPESAFE_TIMEOUT_SECONDS=30
TYPESAFE_MAX_CONCURRENCY=4
TYPESAFE_MAX_REQUEST_BYTES=1048576
TYPESAFE_USAGE_WARNING_TOKENS=10000000
